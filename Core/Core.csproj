<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>FethEditor.Core</AssemblyName>
    <Nullable>disable</Nullable>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <DefineConstants>$(DefineConstants);CROSS_PLATFORM</DefineConstants>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="Database.cs" />
    <Compile Include="Enums.cs" />
    <Compile Include="Util.cs" />
    <Compile Include="Structs/*.cs" />
    <Compile Include="SaveBuffer.cs" />
    <Compile Include="SystemBuffer.cs" />
    <Compile Include="VerifiedFileWriter.cs" />
    <Compile Include="NgPlusJournal.cs" />
    <Compile Include="Resources.cs" />
    <EmbeddedResource Include="Resources/fixed_persondata.bin.gz" LogicalName="fixed_persondata.bin.gz" />
    <EmbeddedResource Include="Resources/fixed_classdata.bin.gz" LogicalName="fixed_classdata.bin.gz" />
    <EmbeddedResource Include="Resources/fixed_data.bin.gz" LogicalName="fixed_data.bin.gz" />
    <EmbeddedResource Include="Resources/msgdata.bin.gz" LogicalName="msgdata.bin.gz" />
    <Content Include="Resources/*.bin.gz" Link="Database/%(Filename)%(Extension)"
             CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
