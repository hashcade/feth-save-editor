<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="FethEditor.Gui.AboutWindow"
        Title="About" Width="440" SizeToContent="Height"
        CanResize="False" WindowStartupLocation="CenterOwner">
  <StackPanel Margin="24" Spacing="16">
    <TextBlock Text="FETH Save Editor" FontWeight="SemiBold" />
    <StackPanel Orientation="Horizontal" Spacing="8">
      <TextBlock Name="VersionLabel" Text="Version:" />
      <TextBlock Name="VersionValue" />
    </StackPanel>
    <Button Content="github.com/jinghaihan/feth-save-editor"
            HorizontalAlignment="Left" Click="OpenProject_Click" />
  </StackPanel>
</Window>
