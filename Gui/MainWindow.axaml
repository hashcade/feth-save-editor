<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="FethEditor.Gui.MainWindow"
        Title="FETH Editor" Width="922" Height="720" MinWidth="820" MinHeight="560"
        Background="#F7F8FA" FontSize="12">
  <Window.Styles>
    <Style Selector="Border.section">
      <Setter Property="Background" Value="White" />
      <Setter Property="BorderBrush" Value="#E4E7EB" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="6" />
      <Setter Property="Padding" Value="16" />
    </Style>
  </Window.Styles>
  <DockPanel>
    <Menu DockPanel.Dock="Top" Height="24" Background="#F7F8FA">
      <MenuItem Header="_File">
        <MenuItem Header="_Load Save..." Click="OpenSave_Click" />
        <MenuItem Name="SaveMenuItem" Header="_Write Edited Copy..."
                  IsEnabled="False" Click="SaveCopy_Click" />
        <Separator />
        <MenuItem Header="E_xit" Click="Exit_Click" />
      </MenuItem>
    </Menu>

    <Border DockPanel.Dock="Bottom" BorderBrush="#E1E3E6" BorderThickness="0,1,0,0"
            Background="#F7F8FA" Padding="6,3">
      <TextBlock Name="Status" Text="Load a version-23 slot or auto save to begin."
                 TextTrimming="CharacterEllipsis" />
    </Border>

    <TabControl Name="EditorTabs" Margin="2,0,2,2">
      <TabItem Header="Main">
        <ScrollViewer Background="#F7F8FA">
          <Grid Margin="8" ColumnDefinitions="216,248,200" RowDefinitions="215,140,205"
                ColumnSpacing="8" RowSpacing="8" HorizontalAlignment="Left">
            <Border Classes="section" Grid.Row="0" Grid.Column="0">
              <HeaderedContentControl>
                <HeaderedContentControl.Header><TextBlock Text="Player" FontWeight="SemiBold" /></HeaderedContentControl.Header>
                <Grid Margin="0,12,0,0" ColumnDefinitions="86,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto"
                      RowSpacing="4" ColumnSpacing="4">
                  <TextBlock Text="Playtime:" VerticalAlignment="Center" />
                  <TextBox Classes="Small" Name="PlaytimeInput" Grid.Column="1" Tag="Player.Playtime"
                           LostFocus="PlayerField_LostFocus" />
                  <TextBlock Grid.Row="1" Text="Money:" VerticalAlignment="Center" />
                  <TextBox Classes="Small" Name="MoneyInput" Grid.Row="1" Grid.Column="1" Tag="Player.Money"
                           LostFocus="PlayerField_LostFocus" />
                  <TextBlock Grid.Row="2" Text="Instruct Exp:" VerticalAlignment="Center" />
                  <TextBox Classes="Small" Name="InstructExpInput" Grid.Row="2" Grid.Column="1"
                           Tag="Activities.InstructExp" LostFocus="PlayerField_LostFocus" />
                  <TextBlock Grid.Row="3" Text="Instruct Level:" VerticalAlignment="Center" />
                  <TextBlock Name="ProfessorLevelValue" Grid.Row="3" Grid.Column="1" Text="-" VerticalAlignment="Center" />
                  <TextBlock Grid.Row="4" Text="Reputation:" VerticalAlignment="Center" />
                  <TextBox Classes="Small" Name="RenownInput" Grid.Row="4" Grid.Column="1"
                           Tag="Activities.Reputation" LostFocus="PlayerField_LostFocus" />
                  <TextBlock Grid.Row="5" Text="Player Name:" VerticalAlignment="Center" />
                  <TextBox Classes="Small" Name="PlayerNameInput" Grid.Row="5" Grid.Column="1"
                           LostFocus="PlayerName_LostFocus" />
                </Grid>
              </HeaderedContentControl>
            </Border>

            <Border Classes="section" Grid.Row="0" Grid.Column="1">
              <HeaderedContentControl>
                <HeaderedContentControl.Header><TextBlock Text="Game Values" FontWeight="SemiBold" /></HeaderedContentControl.Header>
                <StackPanel Name="GameRows" Margin="0,12,0,0" Spacing="4" />
              </HeaderedContentControl>
            </Border>

            <Border Classes="section" Grid.Row="0" Grid.Column="2" VerticalAlignment="Top">
              <HeaderedContentControl>
                <HeaderedContentControl.Header><TextBlock Text="Settings" FontWeight="SemiBold" /></HeaderedContentControl.Header>
              <StackPanel Margin="0,12,0,0" Spacing="4">
                <TextBlock Text="Database Language" />
                <ComboBox Classes="Small" Name="DatabaseLanguage"
                          SelectionChanged="DatabaseLanguage_SelectionChanged" />
              </StackPanel>
              </HeaderedContentControl>
            </Border>

            <Border Classes="section" Grid.Row="1" Grid.Column="0" Grid.RowSpan="2">
              <HeaderedContentControl>
                <HeaderedContentControl.Header><TextBlock Text="Monthly Statistics" FontWeight="SemiBold" /></HeaderedContentControl.Header>
                <StackPanel Name="StatisticsRows" Margin="0,12,0,0" Spacing="2" />
              </HeaderedContentControl>
            </Border>

            <Border Classes="section" Grid.Row="1" Grid.Column="1">
              <HeaderedContentControl>
                <HeaderedContentControl.Header><TextBlock Text="Activity Points" FontWeight="SemiBold" /></HeaderedContentControl.Header>
                <StackPanel Name="ActivityRows" Margin="0,12,0,0" Spacing="4" />
              </HeaderedContentControl>
            </Border>

            <Border Classes="section" Grid.Row="2" Grid.Column="1">
              <HeaderedContentControl>
                <HeaderedContentControl.Header><TextBlock Text="Goddess Statue" FontWeight="SemiBold" /></HeaderedContentControl.Header>
                <StackPanel Name="StatueRows" Margin="0,12,0,0" Spacing="4" />
              </HeaderedContentControl>
            </Border>

          </Grid>
        </ScrollViewer>
      </TabItem>

      <TabItem Header="Storage">
        <Grid Background="#F7F8FA" Margin="8" ColumnDefinitions="264,200,*,*" ColumnSpacing="8">
          <Border Classes="section" Grid.Column="0">
            <Grid RowDefinitions="Auto,*" RowSpacing="12">
              <TextBlock Name="StorageCount" Text="Item List" FontWeight="SemiBold" />
              <ListBox Classes="Small" Name="StorageList" Grid.Row="1"
                       SelectionChanged="StorageList_SelectionChanged" />
            </Grid>
          </Border>
          <StackPanel Grid.Column="1" Spacing="8">
            <Border Classes="section">
              <StackPanel Spacing="8">
                <TextBlock Text="Item Editor" FontWeight="SemiBold" />
                <ComboBox Classes="Small" Name="StorageItemCombo" />
                <TextBlock Text="Durability" />
                <TextBox Classes="Small" Name="StorageDurability" />
                <TextBlock Text="Amount" />
                <TextBox Classes="Small" Name="StorageAmount" />
                <Button Classes="Small" Content="Save Changes" Click="SaveStorageItem_Click" />
              </StackPanel>
            </Border>
            <Border Classes="section">
              <StackPanel Spacing="8">
                <TextBlock Text="Item Tools" FontWeight="SemiBold" />
                <Button Classes="Small" Content="Sort Items" Click="SortStorage_Click" />
                <Button Classes="Small" Content="Add Essential Items" Click="AddEssentialItems_Click" />
                <TextBlock Text="Set Durability" />
                <ComboBox Classes="Small" Name="StorageDurabilityMode" SelectedIndex="0">
                  <ComboBoxItem Content="Normal maximum" />
                  <ComboBoxItem Content="100 (infinite)" />
                  <ComboBoxItem Content="Weapons 100, other maximum" />
                </ComboBox>
                <Button Classes="Small" Content="Apply to Inventory" Click="SetStorageDurability_Click" />
              </StackPanel>
            </Border>
          </StackPanel>
          <Border Classes="section" Grid.Column="2">
            <Grid RowDefinitions="Auto,Auto,*,Auto,Auto" RowSpacing="8">
              <TextBlock Text="Misc Items" FontWeight="SemiBold" />
              <Button Classes="Small" Grid.Row="1" Content="Get All (99)" Click="FillMisc_Click" />
              <ListBox Classes="Small" Name="MiscList" Grid.Row="2"
                       SelectionChanged="MiscList_SelectionChanged" />
              <TextBox Classes="Small" Name="MiscAmount" Grid.Row="3" />
              <Button Classes="Small" Name="SetMisc" Grid.Row="4" Content="Set Selected Amount" Click="SetMisc_Click" />
            </Grid>
          </Border>
          <Border Classes="section" Grid.Column="3">
            <Grid RowDefinitions="Auto,Auto,*,Auto,Auto" RowSpacing="8">
              <TextBlock Text="Gift Items" FontWeight="SemiBold" />
              <Button Classes="Small" Grid.Row="1" Content="Get All (99)" Click="FillGifts_Click" />
              <ListBox Classes="Small" Name="GiftList" Grid.Row="2"
                       SelectionChanged="GiftList_SelectionChanged" />
              <TextBox Classes="Small" Name="GiftAmount" Grid.Row="3" />
              <Button Classes="Small" Grid.Row="4" Content="Set Selected Amount" Click="SetGift_Click" />
            </Grid>
          </Border>
        </Grid>
      </TabItem>

      <TabItem Header="Characters">
        <Grid Background="#F7F8FA" Margin="8" ColumnDefinitions="264,*" ColumnSpacing="8">
          <Border Classes="section" Grid.Column="0">
            <Grid RowDefinitions="Auto,*" RowSpacing="12">
              <TextBlock Text="Character List" FontWeight="SemiBold" />
              <ListBox Classes="Small" Name="CurrentCharacterList" Grid.Row="1"
                       SelectionChanged="CurrentCharacterList_SelectionChanged" />
            </Grid>
          </Border>
          <Grid Grid.Column="1" RowDefinitions="Auto,*" RowSpacing="8">
            <StackPanel Orientation="Horizontal" Spacing="8">
              <TextBlock Name="CurrentCharacterTitle" Text="Select a character"
                         VerticalAlignment="Center" />
              <ComboBox Classes="Small" Name="CurrentCharacterId" Width="180"
                        SelectionChanged="CurrentCharacterId_SelectionChanged" />
              <Button Classes="Small" Content="Export" Click="ExportCharacter_Click" />
              <Button Classes="Small" Content="Import" Click="ImportCharacter_Click" />
            </StackPanel>
            <TabControl Name="CharacterTabs" Grid.Row="1">
              <TabItem Header="Main">
                <ScrollViewer Background="#F7F8FA">
                  <Grid Margin="8" ColumnDefinitions="*,*" ColumnSpacing="8">
                    <StackPanel Spacing="8">
                      <Border Classes="section">
                        <StackPanel Spacing="12">
                          <TextBlock Text="Stats" FontWeight="SemiBold" />
                          <StackPanel Name="CharacterStatRows" Spacing="4" />
                        </StackPanel>
                      </Border>
                      <Border Classes="section">
                        <StackPanel Spacing="12">
                          <TextBlock Text="Item List" FontWeight="SemiBold" />
                          <StackPanel Name="CharacterItemRows" Spacing="4" />
                          <Button Classes="Small" Content="Set Item Durability to 100"
                                  Click="SetCharacterItemsDurability_Click" />
                        </StackPanel>
                      </Border>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Spacing="8">
                      <Border Classes="section">
                        <StackPanel Spacing="12">
                          <TextBlock Text="Equipped Abilities" FontWeight="SemiBold" />
                          <StackPanel Name="EquippedAbilityRows" Spacing="4" />
                        </StackPanel>
                      </Border>
                      <Border Classes="section">
                        <StackPanel Spacing="12">
                          <TextBlock Text="Equipped Combat Arts" FontWeight="SemiBold" />
                          <StackPanel Name="EquippedArtRows" Spacing="4" />
                        </StackPanel>
                      </Border>
                    </StackPanel>
                  </Grid>
                </ScrollViewer>
              </TabItem>
              <TabItem Header="Skills">
                <ScrollViewer Background="#F7F8FA">
                  <Grid Margin="8" ColumnDefinitions="*,*" ColumnSpacing="8">
                    <Border Classes="section">
                      <StackPanel Spacing="12">
                        <TextBlock Text="Skill Experience" FontWeight="SemiBold" />
                        <StackPanel Name="CurrentSkillRows" Spacing="4" />
                        <Button Classes="Small" Content="Max Skill Experience"
                                Click="MaxCharacterSkills_Click" />
                      </StackPanel>
                    </Border>
                    <Border Classes="section" Grid.Column="1">
                      <StackPanel Spacing="12">
                        <TextBlock Text="Learned Magic" FontWeight="SemiBold" />
                        <StackPanel Name="CharacterMagicRows" Spacing="4" />
                      </StackPanel>
                    </Border>
                  </Grid>
                </ScrollViewer>
              </TabItem>
              <TabItem Header="Flags">
                <ScrollViewer Background="#F7F8FA">
                  <Grid Margin="8" ColumnDefinitions="*,*" ColumnSpacing="8">
                    <Border Classes="section">
                      <StackPanel Spacing="12">
                        <TextBlock Text="Character Flags" FontWeight="SemiBold" />
                        <StackPanel Name="CurrentCharacterFlags" Spacing="4" />
                      </StackPanel>
                    </Border>
                    <StackPanel Grid.Column="1" Spacing="8">
                      <Border Classes="section">
                        <StackPanel Spacing="12">
                          <TextBlock Text="Class Flags" FontWeight="SemiBold" />
                          <StackPanel Name="CurrentClassFlags" Spacing="4" />
                        </StackPanel>
                      </Border>
                      <Border Classes="section">
                        <StackPanel Spacing="8">
                          <TextBlock Text="Adjutant" FontWeight="SemiBold" />
                          <ComboBox Classes="Small" Name="CurrentAdjutant"
                                    SelectionChanged="CurrentAdjutant_SelectionChanged" />
                        </StackPanel>
                      </Border>
                    </StackPanel>
                  </Grid>
                </ScrollViewer>
              </TabItem>
              <TabItem Header="Class Exp">
                <Grid Background="#F7F8FA" Margin="8" ColumnDefinitions="*,200" ColumnSpacing="8">
                  <Border Classes="section">
                    <Grid RowDefinitions="Auto,*" RowSpacing="12">
                      <TextBlock Text="Class Experience" FontWeight="SemiBold" />
                      <ListBox Classes="Small" Name="CurrentClassExpList" Grid.Row="1"
                               SelectionChanged="CurrentClassExpList_SelectionChanged" />
                    </Grid>
                  </Border>
                  <StackPanel Grid.Column="1" Spacing="8">
                    <Border Classes="section">
                      <StackPanel Spacing="8">
                        <TextBlock Text="Class Editor" FontWeight="SemiBold" />
                        <TextBlock Name="CurrentClassInfo" Text="Current class" TextWrapping="Wrap" />
                        <TextBlock Text="Experience" />
                        <TextBox Classes="Small" Name="SelectedClassExp" />
                        <TextBlock Text="Mastery Level (0 or 1)" />
                        <TextBox Classes="Small" Name="SelectedClassLevel" />
                        <Button Classes="Small" Name="SetCharacterClassButton" Content="Set Class Values"
                                Click="SetCharacterClass_Click" />
                      </StackPanel>
                    </Border>
                    <Button Classes="Small" Content="Max All Class Experience"
                            Click="MaxCharacterClasses_Click" />
                  </StackPanel>
                </Grid>
              </TabItem>
              <TabItem Header="Class Flags">
                <ScrollViewer Background="#F7F8FA">
                  <Border Classes="section" Margin="8">
                    <StackPanel Spacing="12">
                      <TextBlock Text="Class Unlock Flags" FontWeight="SemiBold" />
                      <StackPanel Name="CurrentClassUnlockFlags" Spacing="4" />
                    </StackPanel>
                  </Border>
                </ScrollViewer>
              </TabItem>
              <TabItem Header="Abilities">
                <ScrollViewer Background="#F7F8FA">
                  <Border Classes="section" Margin="8">
                    <StackPanel Spacing="12">
                      <TextBlock Text="Abilities" FontWeight="SemiBold" />
                      <Button Classes="Small" Content="Unlock All" HorizontalAlignment="Left"
                              Click="UnlockAllAbilities_Click" />
                      <StackPanel Name="CurrentAbilityFlags" Spacing="4" />
                    </StackPanel>
                  </Border>
                </ScrollViewer>
              </TabItem>
              <TabItem Header="Combat Arts">
                <ScrollViewer Background="#F7F8FA">
                  <Border Classes="section" Margin="8">
                    <StackPanel Spacing="12">
                      <TextBlock Text="Combat Arts" FontWeight="SemiBold" />
                      <Button Classes="Small" Content="Unlock All" HorizontalAlignment="Left"
                              Click="UnlockAllCombatArts_Click" />
                      <StackPanel Name="CurrentArtFlags" Spacing="4" />
                    </StackPanel>
                  </Border>
                </ScrollViewer>
              </TabItem>
            </TabControl>
          </Grid>
        </Grid>
      </TabItem>

      <TabItem Header="Battalion">
        <Grid Background="#F7F8FA" Margin="8" ColumnDefinitions="264,220,*" ColumnSpacing="8">
          <Border Classes="section" Grid.Column="0">
            <Grid RowDefinitions="Auto,*" RowSpacing="12">
              <TextBlock Text="Battalion List" FontWeight="SemiBold" />
              <ListBox Classes="Small" Name="BattalionList" Grid.Row="1"
                       SelectionChanged="BattalionList_SelectionChanged" />
            </Grid>
          </Border>
          <StackPanel Grid.Column="1" Spacing="8">
            <Border Classes="section">
              <StackPanel Spacing="8">
                <TextBlock Text="Battalion Editor" FontWeight="SemiBold" />
                <TextBlock Text="Character" />
                <ComboBox Classes="Small" Name="BattalionCharacter" />
                <TextBlock Text="Type" />
                <ComboBox Classes="Small" Name="BattalionType" />
                <TextBlock Text="Experience" />
                <TextBox Classes="Small" Name="BattalionExp" />
                <TextBlock Text="Stamina" />
                <TextBox Classes="Small" Name="BattalionStamina" />
                <TextBlock Text="Skill" />
                <ComboBox Classes="Small" Name="BattalionSkill" />
                <Button Classes="Small" Name="SaveBattalionButton" Content="Save Changes" Click="SaveBattalion_Click" />
              </StackPanel>
            </Border>
            <Button Classes="Small" Content="Sort Battalion" Click="SortBattalion_Click" />
          </StackPanel>
        </Grid>
      </TabItem>

      <TabItem Header="Quest">
        <Grid Background="#F7F8FA" Margin="8" ColumnDefinitions="312,256,*" ColumnSpacing="8">
          <Border Classes="section" Grid.Column="0">
            <Grid RowDefinitions="Auto,*" RowSpacing="12">
              <TextBlock Text="Quest List" FontWeight="SemiBold" />
              <ListBox Classes="Small" Name="QuestList" Grid.Row="1"
                       SelectionChanged="QuestList_SelectionChanged" />
            </Grid>
          </Border>
          <Border Classes="section" Grid.Column="1" VerticalAlignment="Top">
            <StackPanel Spacing="8">
              <TextBlock Text="Quest Editor" FontWeight="SemiBold" />
              <ComboBox Classes="Small" Name="QuestState" />
              <Button Classes="Small" Name="SetQuestStateButton" Content="Set State" Click="SetQuestState_Click" />
            </StackPanel>
          </Border>
        </Grid>
      </TabItem>

      <TabItem Header="Support Talks">
        <Grid Background="#F7F8FA" Margin="8" ColumnDefinitions="312,256,*" ColumnSpacing="8">
          <Border Classes="section" Grid.Column="0">
            <Grid RowDefinitions="Auto,*" RowSpacing="12">
              <TextBlock Text="Talk List" FontWeight="SemiBold" />
              <ListBox Classes="Small" Name="CurrentSupportList" Grid.Row="1"
                       SelectionChanged="CurrentSupportList_SelectionChanged" />
            </Grid>
          </Border>
          <Border Classes="section" Grid.Column="1" VerticalAlignment="Top">
            <StackPanel Spacing="8">
              <TextBlock Text="Talk Editor" FontWeight="SemiBold" />
              <TextBlock Text="Current support points" />
              <TextBox Classes="Small" Name="CurrentSupportPoints" />
              <Button Classes="Small" Name="SetCurrentSupportButton" Content="Set Points" Click="SetCurrentSupport_Click" />
            </StackPanel>
          </Border>
        </Grid>
      </TabItem>

      <TabItem Header="NG+ Characters">
        <Grid Background="#F7F8FA" Margin="8" ColumnDefinitions="264,*" ColumnSpacing="8">
          <Border Classes="section" Grid.Column="0">
            <Grid RowDefinitions="Auto,*" RowSpacing="12">
              <TextBlock Text="Character List" FontWeight="SemiBold" />
              <Grid Grid.Row="1" RowDefinitions="Auto,*" RowSpacing="5">
                <TextBox Classes="Small" Name="CharacterSearch" PlaceholderText="Search characters..."
                         TextChanged="CharacterSearch_TextChanged" />
                <ListBox Classes="Small" Name="CharacterList" Grid.Row="1"
                         SelectionChanged="CharacterList_SelectionChanged" />
              </Grid>
            </Grid>
          </Border>

          <Grid Grid.Column="1" RowDefinitions="Auto,*" RowSpacing="8">
            <TextBlock Name="SelectedCharacter" Margin="4,4,0,0" Text="Select a character" />
            <TabControl Grid.Row="1">
              <TabItem Header="Skills">
                <ScrollViewer Background="#F7F8FA">
                  <Border Classes="section" Margin="8">
                    <StackPanel Spacing="12">
                      <TextBlock Text="Historical Skill Ranks" FontWeight="SemiBold" />
                      <StackPanel Name="SkillRows" Spacing="5" />
                    </StackPanel>
                  </Border>
                </ScrollViewer>
              </TabItem>
              <TabItem Header="Class Flags">
                <Grid Background="#F7F8FA" Margin="8" RowDefinitions="Auto,*" RowSpacing="6">
                  <TextBox Classes="Small" Name="ClassSearch" PlaceholderText="Search classes..."
                           TextChanged="ClassSearch_TextChanged" />
                  <ScrollViewer Grid.Row="1">
                    <StackPanel Name="ClassRows" Spacing="4" />
                  </ScrollViewer>
                </Grid>
              </TabItem>
            </TabControl>
          </Grid>
        </Grid>
      </TabItem>

      <TabItem Header="NG+ Support Talks">
        <Grid Background="#F7F8FA" Margin="8" ColumnDefinitions="312,*" ColumnSpacing="8">
          <Border Classes="section" Grid.Column="0">
            <Grid RowDefinitions="Auto,*" RowSpacing="12">
              <TextBlock Text="Talk List" FontWeight="SemiBold" />
              <Grid Grid.Row="1" RowDefinitions="Auto,*" RowSpacing="5">
                <TextBox Classes="Small" Name="SupportSearch" PlaceholderText="Search character pairs..."
                         TextChanged="SupportSearch_TextChanged" />
                <ListBox Classes="Small" Name="SupportList" Grid.Row="1"
                         SelectionChanged="SupportList_SelectionChanged" />
              </Grid>
            </Grid>
          </Border>
          <Grid Grid.Column="1" RowDefinitions="130,*" RowSpacing="8">
            <Border Classes="section">
              <StackPanel Spacing="12">
                <TextBlock Text="Talk Editor" FontWeight="SemiBold" />
                <Grid RowDefinitions="Auto,Auto" ColumnDefinitions="100,160,*" RowSpacing="7">
                  <TextBlock Name="SelectedSupport" Grid.ColumnSpan="3" Text="Select a support pair"
                             TextWrapping="Wrap" />
                  <TextBlock Grid.Row="1" Text="Max points:" VerticalAlignment="Center" />
                  <TextBox Classes="Small" Name="SupportPointsInput" Grid.Row="1" Grid.Column="1" />
                  <Button Classes="Small" Grid.Row="1" Grid.Column="2" Margin="6,0,0,0" HorizontalAlignment="Left"
                          Content="Set" Click="ApplySupport_Click" />
                </Grid>
              </StackPanel>
            </Border>
            <TextBlock Grid.Row="1" Margin="8,0" TextWrapping="Wrap"
                       Text="Historical support points are stored separately from this run. Values outside known game ranges may not be meaningful." />
          </Grid>
        </Grid>
      </TabItem>
    </TabControl>
  </DockPanel>
</Window>
