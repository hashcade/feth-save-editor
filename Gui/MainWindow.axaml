<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:suki="https://github.com/kikipoulet/SukiUI"
        x:Class="FethEditor.Gui.MainWindow"
        Title="FETH Editor" Width="1120" Height="780" MinWidth="860" MinHeight="600"
        FontSize="13" DragDrop.AllowDrop="True">
  <Window.Styles>
    <Style Selector="suki|GlassCard.section">
      <Setter Property="Padding" Value="20" />
    </Style>
    <Style Selector="Border.section">
      <Setter Property="Padding" Value="20" />
    </Style>
    <Style Selector="Border.section Button, Border.section ComboBox, Border.section TextBox">
      <Setter Property="HorizontalAlignment" Value="Stretch" />
    </Style>
    <Style Selector="ListBoxItem">
      <Setter Property="Padding" Value="10,7" />
    </Style>
    <Style Selector="TabControl#EditorTabs /template/ ItemsPresenter#PART_ItemsPresenter">
      <Setter Property="IsVisible" Value="False" />
    </Style>
    <Style Selector="TabControl#EditorTabs /template/ Border#PART_BorderSeparator">
      <Setter Property="IsVisible" Value="False" />
    </Style>
  </Window.Styles>
  <Grid>
  <DockPanel>
    <Grid DockPanel.Dock="Top" ColumnDefinitions="Auto,*">
        <Menu VerticalAlignment="Center">
          <MenuItem Header="_File">
            <MenuItem Header="_Load Save..." Click="OpenSave_Click" />
            <MenuItem Name="SaveMenuItem" Header="_Write Save..."
                      IsEnabled="False" Click="SaveCopy_Click" />
            <MenuItem Header="_System Save Editor..." Click="OpenSystemEditor_Click" />
            <Separator />
            <MenuItem Header="E_xit" Click="Exit_Click" />
          </MenuItem>
          <MenuItem Name="LanguageMenu" Header="Language" />
        </Menu>
        <ScrollViewer Grid.Column="1" HorizontalAlignment="Right" HorizontalScrollBarVisibility="Auto"
                      VerticalScrollBarVisibility="Disabled">
          <TabStrip Name="MainNavigation" SelectedIndex="{Binding SelectedIndex, ElementName=EditorTabs, Mode=TwoWay}">
            <TabStripItem Content="{Binding Header, ElementName=MainTab}" />
            <TabStripItem Content="{Binding Header, ElementName=StorageTab}" />
            <TabStripItem Content="{Binding Header, ElementName=CharactersTab}" />
            <TabStripItem Content="{Binding Header, ElementName=BattalionTab}" />
            <TabStripItem Content="{Binding Header, ElementName=QuestTab}" />
            <TabStripItem Content="{Binding Header, ElementName=SupportTab}" />
            <TabStripItem Content="{Binding Header, ElementName=DatabaseTab}" />
            <TabStripItem Content="{Binding Header, ElementName=InheritanceCharactersTab}" />
            <TabStripItem Content="{Binding Header, ElementName=InheritanceSupportTab}" />
          </TabStrip>
        </ScrollViewer>
    </Grid>

    <TabControl Name="EditorTabs" Margin="16,8,16,16">
      <TabItem Name="MainTab" Header="Main">
        <ScrollViewer>
          <Grid Margin="12" ColumnDefinitions="*,*" ColumnSpacing="12">
            <StackPanel Spacing="12">
            <suki:GlassCard Classes="section">
              <HeaderedContentControl>
                <HeaderedContentControl.Header><TextBlock Text="Player" FontWeight="SemiBold" /></HeaderedContentControl.Header>
                <Grid Margin="0,16,0,0" ColumnDefinitions="160,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto"
                      RowSpacing="8" ColumnSpacing="8">
                  <TextBlock Text="Playtime:" VerticalAlignment="Center" />
                  <TextBox Classes="Small" Name="PlaytimeInput" Grid.Column="1" Tag="Player.Playtime"
                           LostFocus="PlayerField_LostFocus" />
                  <TextBlock Grid.Row="1" Text="Money:" VerticalAlignment="Center" />
                  <TextBox Classes="Small" Name="MoneyInput" Grid.Row="1" Grid.Column="1" Tag="Player.Money"
                           LostFocus="PlayerField_LostFocus" />
                  <TextBlock Grid.Row="2" Text="Instruct Exp:" VerticalAlignment="Center" />
                  <TextBox Classes="Small" Name="InstructExpInput" Grid.Row="2" Grid.Column="1"
                           Tag="Activities.InstructExp" LostFocus="PlayerField_LostFocus" />
                  <TextBlock Grid.Row="3" Text="Instruct Level:" VerticalAlignment="Center" />
                  <TextBlock Name="ProfessorLevelValue" Grid.Row="3" Grid.Column="1" Text="-" VerticalAlignment="Center" />
                  <TextBlock Grid.Row="4" Text="Inherited rank:" VerticalAlignment="Center" />
                  <ComboBox Classes="Small" Name="NgPlusProfessorRank" Grid.Row="4" Grid.Column="1"
                            SelectionChanged="NgPlusProfessorRank_SelectionChanged" />
                  <TextBlock Grid.Row="5" Text="Reputation:" VerticalAlignment="Center" />
                  <TextBox Classes="Small" Name="RenownInput" Grid.Row="5" Grid.Column="1"
                           Tag="Activities.Reputation" LostFocus="PlayerField_LostFocus" />
                  <TextBlock Grid.Row="6" Text="Player Name:" VerticalAlignment="Center" />
                  <TextBox Classes="Small" Name="PlayerNameInput" Grid.Row="6" Grid.Column="1"
                           LostFocus="PlayerName_LostFocus" />
                </Grid>
              </HeaderedContentControl>
            </suki:GlassCard>

            <suki:GlassCard Classes="section">
              <HeaderedContentControl>
                <HeaderedContentControl.Header><TextBlock Text="Game Values" FontWeight="SemiBold" /></HeaderedContentControl.Header>
                <StackPanel Name="GameRows" Margin="0,16,0,0" Spacing="8" />
              </HeaderedContentControl>
            </suki:GlassCard>

            </StackPanel>
            <StackPanel Grid.Column="1" Spacing="12">
            <suki:GlassCard Classes="section">
              <HeaderedContentControl>
                <HeaderedContentControl.Header><TextBlock Text="Monthly Statistics" FontWeight="SemiBold" /></HeaderedContentControl.Header>
                <StackPanel Name="StatisticsRows" Margin="0,16,0,0" Spacing="6" />
              </HeaderedContentControl>
            </suki:GlassCard>

              <suki:GlassCard Classes="section">
                <HeaderedContentControl>
                  <HeaderedContentControl.Header><TextBlock Text="Activity Points" FontWeight="SemiBold" /></HeaderedContentControl.Header>
                  <StackPanel Name="ActivityRows" Margin="0,16,0,0" Spacing="8" />
                </HeaderedContentControl>
              </suki:GlassCard>
              <suki:GlassCard Classes="section">
                <HeaderedContentControl>
                  <HeaderedContentControl.Header><TextBlock Text="Goddess Statue" FontWeight="SemiBold" /></HeaderedContentControl.Header>
                  <StackPanel Name="StatueRows" Margin="0,16,0,0" Spacing="8" />
                </HeaderedContentControl>
              </suki:GlassCard>
            </StackPanel>
          </Grid>
        </ScrollViewer>
      </TabItem>

      <TabItem Name="StorageTab" Header="Storage">
        <Grid Margin="8" ColumnDefinitions="250,220,*,*" ColumnSpacing="10">
          <suki:GlassCard Name="StorageListCard" Classes="section" Grid.Column="0">
            <Grid RowDefinitions="Auto,*" RowSpacing="12">
              <TextBlock Name="StorageCount" Text="Item List" FontWeight="SemiBold" />
              <ListBox Classes="Small" Name="StorageList" Grid.Row="1"
                       SelectionChanged="StorageList_SelectionChanged" />
            </Grid>
          </suki:GlassCard>
          <Grid Grid.Column="1" RowDefinitions="*,*" RowSpacing="10">
            <suki:GlassCard Name="StorageEditorCard" Classes="section">
              <StackPanel Spacing="8">
                <TextBlock Text="Item Editor" FontWeight="SemiBold" />
                <ComboBox Classes="Small" Name="StorageItemCombo" />
                <TextBlock Text="Durability" />
                <TextBox Classes="Small" Name="StorageDurability" />
                <TextBlock Text="Amount" />
                <TextBox Classes="Small" Name="StorageAmount" />
                <Button Classes="Small" Content="Save Changes" Click="SaveStorageItem_Click" />
              </StackPanel>
            </suki:GlassCard>
            <suki:GlassCard Name="StorageToolsCard" Classes="section" Grid.Row="1">
              <StackPanel Spacing="8">
                <TextBlock Text="Item Tools" FontWeight="SemiBold" />
                <Button Classes="Small" Content="Sort Items" Click="SortStorage_Click" />
                <Button Classes="Small" Content="Add Essential Items" Click="AddEssentialItems_Click" />
                <TextBlock Text="Set Durability" />
                <ComboBox Classes="Small" Name="StorageDurabilityMode" SelectedIndex="0">
                  <ComboBoxItem Content="Normal maximum" />
                  <ComboBoxItem Content="100 (infinite)" />
                  <ComboBoxItem Content="Weapons 100, other maximum" />
                </ComboBox>
                <Button Classes="Small" Content="Apply to Inventory" Click="SetStorageDurability_Click" />
              </StackPanel>
            </suki:GlassCard>
          </Grid>
          <suki:GlassCard Name="StorageMiscCard" Classes="section" Grid.Column="2">
            <Grid RowDefinitions="Auto,Auto,*,Auto,Auto" RowSpacing="8">
              <TextBlock Text="Misc Items" FontWeight="SemiBold" />
              <Button Classes="Small" Grid.Row="1" Content="Get All (99)" Click="FillMisc_Click" />
              <ListBox Classes="Small" Name="MiscList" Grid.Row="2"
                       SelectionChanged="MiscList_SelectionChanged" />
              <TextBox Classes="Small" Name="MiscAmount" Grid.Row="3" />
              <Button Classes="Small" Name="SetMisc" Grid.Row="4" Content="Set Selected Amount" Click="SetMisc_Click" />
            </Grid>
          </suki:GlassCard>
          <suki:GlassCard Name="StorageGiftCard" Classes="section" Grid.Column="3">
            <Grid RowDefinitions="Auto,Auto,*,Auto,Auto" RowSpacing="8">
              <TextBlock Text="Gift Items" FontWeight="SemiBold" />
              <Button Classes="Small" Grid.Row="1" Content="Get All (99)" Click="FillGifts_Click" />
              <ListBox Classes="Small" Name="GiftList" Grid.Row="2"
                       SelectionChanged="GiftList_SelectionChanged" />
              <TextBox Classes="Small" Name="GiftAmount" Grid.Row="3" />
              <Button Classes="Small" Grid.Row="4" Content="Set Selected Amount" Click="SetGift_Click" />
            </Grid>
          </suki:GlassCard>
        </Grid>
      </TabItem>

      <TabItem Name="CharactersTab" Header="Characters">
        <Grid Margin="8" ColumnDefinitions="264,*" ColumnSpacing="8">
          <suki:GlassCard Name="CharacterListCard" Classes="section" Grid.Column="0">
            <Grid RowDefinitions="Auto,*" RowSpacing="12">
              <TextBlock Text="Character List" FontWeight="SemiBold" />
              <ListBox Classes="Small" Name="CurrentCharacterList" Grid.Row="1"
                       SelectionChanged="CurrentCharacterList_SelectionChanged" />
            </Grid>
          </suki:GlassCard>
          <suki:GlassCard Name="CharacterEditorCard" Classes="section" Grid.Column="1">
          <Grid RowDefinitions="Auto,*" RowSpacing="8">
            <StackPanel Orientation="Horizontal" Spacing="8">
              <TextBlock Name="CurrentCharacterTitle" Text="Select a character"
                         VerticalAlignment="Center" />
              <ComboBox Classes="Small" Name="CurrentCharacterId" MinWidth="180"
                        SelectionChanged="CurrentCharacterId_SelectionChanged" />
              <Button Classes="Small" Content="Export" Click="ExportCharacter_Click" />
              <Button Classes="Small" Content="Import" Click="ImportCharacter_Click" />
            </StackPanel>
            <TabControl Name="CharacterTabs" Grid.Row="1">
              <TabItem Header="Main">
                <ScrollViewer Name="CharacterMainScroll">
                  <Grid Margin="8" ColumnDefinitions="*,*" ColumnSpacing="8">
                    <StackPanel Spacing="8">
                      <Border Classes="section">
                        <StackPanel Spacing="12">
                          <TextBlock Text="Stats" FontWeight="SemiBold" />
                          <StackPanel Name="CharacterStatRows" Spacing="4" />
                        </StackPanel>
                      </Border>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Spacing="8">
                      <Border Classes="section">
                        <StackPanel Spacing="12">
                          <TextBlock Text="Equipped Abilities" FontWeight="SemiBold" />
                          <StackPanel Name="EquippedAbilityRows" Spacing="4" />
                        </StackPanel>
                      </Border>
                      <Border Classes="section">
                        <StackPanel Spacing="12">
                          <TextBlock Text="Equipped Combat Arts" FontWeight="SemiBold" />
                          <StackPanel Name="EquippedArtRows" Spacing="4" />
                        </StackPanel>
                      </Border>
                      <Border Classes="section">
                        <StackPanel Spacing="12">
                          <TextBlock Text="Item List" FontWeight="SemiBold" />
                          <StackPanel Name="CharacterItemRows" Spacing="4" />
                          <Button Classes="Small" Content="Set Item Durability to 100"
                                  Click="SetCharacterItemsDurability_Click" />
                        </StackPanel>
                      </Border>
                    </StackPanel>
                  </Grid>
                </ScrollViewer>
              </TabItem>
              <TabItem Header="Skills">
                <ScrollViewer>
                  <Grid Margin="8" ColumnDefinitions="*,*" ColumnSpacing="8">
                    <Border Classes="section">
                      <StackPanel Spacing="12">
                        <TextBlock Text="Skill Experience" FontWeight="SemiBold" />
                        <StackPanel Name="CurrentSkillRows" Spacing="4" />
                        <Button Classes="Small" Content="Max Skill Experience"
                                Click="MaxCharacterSkills_Click" />
                      </StackPanel>
                    </Border>
                    <Border Classes="section" Grid.Column="1">
                      <StackPanel Spacing="12">
                        <TextBlock Text="Learned Magic" FontWeight="SemiBold" />
                        <StackPanel Name="CharacterMagicRows" Spacing="4" />
                      </StackPanel>
                    </Border>
                  </Grid>
                </ScrollViewer>
              </TabItem>
              <TabItem Header="Flags">
                <ScrollViewer>
                  <Grid Margin="8" ColumnDefinitions="*,*" ColumnSpacing="8">
                    <Border Classes="section">
                      <StackPanel Spacing="12">
                        <TextBlock Text="Character Flags" FontWeight="SemiBold" />
                        <StackPanel Name="CurrentCharacterFlags" Spacing="4" />
                      </StackPanel>
                    </Border>
                    <StackPanel Grid.Column="1" Spacing="8">
                      <Border Classes="section">
                        <StackPanel Spacing="12">
                          <TextBlock Text="Class Flags" FontWeight="SemiBold" />
                          <StackPanel Name="CurrentClassFlags" Spacing="4" />
                        </StackPanel>
                      </Border>
                      <Border Classes="section">
                        <StackPanel Spacing="8">
                          <TextBlock Text="Adjutant" FontWeight="SemiBold" />
                          <ComboBox Classes="Small" Name="CurrentAdjutant"
                                    SelectionChanged="CurrentAdjutant_SelectionChanged" />
                        </StackPanel>
                      </Border>
                    </StackPanel>
                  </Grid>
                </ScrollViewer>
              </TabItem>
              <TabItem Header="Class Exp">
                <Grid Margin="8" ColumnDefinitions="*,200" ColumnSpacing="8">
                  <Border Classes="section">
                    <Grid RowDefinitions="Auto,*" RowSpacing="12">
                      <TextBlock Text="Class Experience" FontWeight="SemiBold" />
                      <ListBox Classes="Small" Name="CurrentClassExpList" Grid.Row="1"
                               SelectionChanged="CurrentClassExpList_SelectionChanged" />
                    </Grid>
                  </Border>
                  <StackPanel Grid.Column="1" Spacing="8">
                    <Border Classes="section">
                      <StackPanel Spacing="8">
                        <TextBlock Text="Class Editor" FontWeight="SemiBold" />
                        <TextBlock Name="CurrentClassInfo" Text="Current class" TextWrapping="Wrap" />
                        <TextBlock Text="Experience" />
                        <TextBox Classes="Small" Name="SelectedClassExp" />
                        <TextBlock Text="Mastery Level (0 or 1)" />
                        <TextBox Classes="Small" Name="SelectedClassLevel" />
                        <Button Classes="Small" Name="SetCharacterClassButton" Content="Set Class Values"
                                Click="SetCharacterClass_Click" />
                      </StackPanel>
                    </Border>
                    <Button Classes="Small" Content="Max All Class Experience"
                            Click="MaxCharacterClasses_Click" />
                  </StackPanel>
                </Grid>
              </TabItem>
              <TabItem Header="Class Flags">
                <ScrollViewer>
                  <Border Classes="section" Margin="8">
                    <StackPanel Spacing="12">
                      <TextBlock Text="Class Unlock Flags" FontWeight="SemiBold" />
                      <StackPanel Name="CurrentClassUnlockFlags" Spacing="4" />
                    </StackPanel>
                  </Border>
                </ScrollViewer>
              </TabItem>
              <TabItem Header="Abilities">
                <ScrollViewer>
                  <Border Classes="section" Margin="8">
                    <StackPanel Spacing="12">
                      <Grid ColumnDefinitions="*,Auto">
                        <TextBlock Text="Abilities" FontWeight="SemiBold" VerticalAlignment="Center" />
                        <Button Name="UnlockAllAbilitiesButton" Classes="Small" Grid.Column="1"
                                Content="Unlock All" HorizontalAlignment="Right"
                                Click="UnlockAllAbilities_Click" />
                      </Grid>
                      <StackPanel Name="CurrentAbilityFlags" Spacing="4" />
                    </StackPanel>
                  </Border>
                </ScrollViewer>
              </TabItem>
              <TabItem Header="Combat Arts">
                <ScrollViewer>
                  <Border Classes="section" Margin="8">
                    <StackPanel Spacing="12">
                      <Grid ColumnDefinitions="*,Auto">
                        <TextBlock Text="Combat Arts" FontWeight="SemiBold" VerticalAlignment="Center" />
                        <Button Name="UnlockAllArtsButton" Classes="Small" Grid.Column="1"
                                Content="Unlock All" HorizontalAlignment="Right"
                                Click="UnlockAllCombatArts_Click" />
                      </Grid>
                      <StackPanel Name="CurrentArtFlags" Spacing="4" />
                    </StackPanel>
                  </Border>
                </ScrollViewer>
              </TabItem>
            </TabControl>
          </Grid>
          </suki:GlassCard>
        </Grid>
      </TabItem>

      <TabItem Name="BattalionTab" Header="Battalion">
        <Grid Margin="8" ColumnDefinitions="320,*" ColumnSpacing="10">
          <suki:GlassCard Name="BattalionListCard" Classes="section" Grid.Column="0">
            <Grid RowDefinitions="Auto,*" RowSpacing="12">
              <TextBlock Text="Battalion List" FontWeight="SemiBold" />
              <ListBox Classes="Small" Name="BattalionList" Grid.Row="1"
                       SelectionChanged="BattalionList_SelectionChanged" />
            </Grid>
          </suki:GlassCard>
          <suki:GlassCard Name="BattalionEditorCard" Classes="section" Grid.Column="1">
            <StackPanel Width="340" HorizontalAlignment="Left" Spacing="8">
              <TextBlock Text="Battalion Editor" FontWeight="SemiBold" />
              <TextBlock Text="Character" />
              <ComboBox Classes="Small" Name="BattalionCharacter" />
              <TextBlock Text="Type" />
              <ComboBox Classes="Small" Name="BattalionType" />
              <TextBlock Text="Experience" />
              <TextBox Classes="Small" Name="BattalionExp" />
              <TextBlock Text="Stamina" />
              <TextBox Classes="Small" Name="BattalionStamina" />
              <TextBlock Text="Skill" />
              <ComboBox Classes="Small" Name="BattalionSkill" />
              <Button Classes="Small" Name="SaveBattalionButton" Content="Save Changes" Click="SaveBattalion_Click" />
              <Button Classes="Small" Content="Sort Battalion" Click="SortBattalion_Click" />
            </StackPanel>
          </suki:GlassCard>
        </Grid>
      </TabItem>

      <TabItem Name="QuestTab" Header="Quest">
        <Grid Margin="8" ColumnDefinitions="312,256,*" ColumnSpacing="8">
          <Border Classes="section" Grid.Column="0">
            <Grid RowDefinitions="Auto,*" RowSpacing="12">
              <TextBlock Text="Quest List" FontWeight="SemiBold" />
              <ListBox Classes="Small" Name="QuestList" Grid.Row="1"
                       SelectionChanged="QuestList_SelectionChanged" />
            </Grid>
          </Border>
          <Border Classes="section" Grid.Column="1" VerticalAlignment="Top">
            <StackPanel Spacing="8">
              <TextBlock Text="Quest Editor" FontWeight="SemiBold" />
              <ComboBox Classes="Small" Name="QuestState" />
              <Button Classes="Small" Name="SetQuestStateButton" Content="Set State" Click="SetQuestState_Click" />
            </StackPanel>
          </Border>
        </Grid>
      </TabItem>

      <TabItem Name="SupportTab" Header="Support Talks">
        <Grid Margin="8" ColumnDefinitions="312,256,*" ColumnSpacing="8">
          <Border Classes="section" Grid.Column="0">
            <Grid RowDefinitions="Auto,*" RowSpacing="12">
              <TextBlock Text="Talk List" FontWeight="SemiBold" />
              <ListBox Classes="Small" Name="CurrentSupportList" Grid.Row="1"
                       SelectionChanged="CurrentSupportList_SelectionChanged" />
            </Grid>
          </Border>
          <Border Classes="section" Grid.Column="1" VerticalAlignment="Top">
            <StackPanel Spacing="8">
              <TextBlock Text="Talk Editor" FontWeight="SemiBold" />
              <TextBlock Text="Current support points" />
              <TextBox Classes="Small" Name="CurrentSupportPoints" />
              <Button Classes="Small" Name="SetCurrentSupportButton" Content="Set Points" Click="SetCurrentSupport_Click" />
            </StackPanel>
          </Border>
        </Grid>
      </TabItem>

      <TabItem Name="DatabaseTab" Header="Database">
        <TabControl Margin="8">
          <TabItem Header="Characters">
            <Grid ColumnDefinitions="264,*" ColumnSpacing="8" Margin="0,8,0,0">
              <Border Classes="section">
                <Grid RowDefinitions="Auto,*" RowSpacing="12">
                  <TextBlock Text="Character Database" FontWeight="SemiBold" />
                  <ListBox Classes="Small" Name="DatabaseCharacters" Grid.Row="1"
                           SelectionChanged="DatabaseCharacters_SelectionChanged" />
                </Grid>
              </Border>
              <Border Classes="section" Grid.Column="1">
                <TextBox Name="DatabaseCharacterDetails" IsReadOnly="True"
                         AcceptsReturn="True" TextWrapping="Wrap" />
              </Border>
            </Grid>
          </TabItem>
          <TabItem Header="Classes">
            <Grid ColumnDefinitions="264,*" ColumnSpacing="8" Margin="0,8,0,0">
              <Border Classes="section">
                <Grid RowDefinitions="Auto,*" RowSpacing="12">
                  <TextBlock Text="Class Database" FontWeight="SemiBold" />
                  <ListBox Classes="Small" Name="DatabaseClasses" Grid.Row="1"
                           SelectionChanged="DatabaseClasses_SelectionChanged" />
                </Grid>
              </Border>
              <Border Classes="section" Grid.Column="1">
                <TextBox Name="DatabaseClassDetails" IsReadOnly="True"
                         AcceptsReturn="True" TextWrapping="Wrap" />
              </Border>
            </Grid>
          </TabItem>
          <TabItem Header="Items">
            <Grid ColumnDefinitions="264,*" ColumnSpacing="8" Margin="0,8,0,0">
              <Border Classes="section">
                <Grid RowDefinitions="Auto,*" RowSpacing="12">
                  <TextBlock Text="Item Database" FontWeight="SemiBold" />
                  <ListBox Classes="Small" Name="DatabaseItems" Grid.Row="1"
                           SelectionChanged="DatabaseItems_SelectionChanged" />
                </Grid>
              </Border>
              <Border Classes="section" Grid.Column="1">
                <TextBox Name="DatabaseItemDetails" IsReadOnly="True"
                         AcceptsReturn="True" TextWrapping="Wrap" />
              </Border>
            </Grid>
          </TabItem>
        </TabControl>
      </TabItem>

      <TabItem Name="InheritanceCharactersTab" Header="NG+ Characters">
        <Grid Margin="8" ColumnDefinitions="248,*" ColumnSpacing="12">
          <Border Classes="section" Grid.Column="0">
            <Grid RowDefinitions="Auto,*" RowSpacing="12">
              <TextBlock Text="Character List" FontWeight="SemiBold" />
              <Grid Grid.Row="1" RowDefinitions="Auto,*" RowSpacing="5">
                <TextBox Classes="Small" Name="CharacterSearch" PlaceholderText="Search characters..."
                         TextChanged="CharacterSearch_TextChanged" />
                <ListBox Classes="Small" Name="CharacterList" Grid.Row="1"
                         SelectionChanged="CharacterList_SelectionChanged" />
              </Grid>
            </Grid>
          </Border>

          <Grid Grid.Column="1" RowDefinitions="Auto,*" RowSpacing="10">
            <TextBlock Name="SelectedCharacter" Margin="4,6,0,0" Text="Select a character"
                       FontSize="17" FontWeight="SemiBold" />
            <TabControl Name="InheritanceTabs" Grid.Row="1">
              <TabItem Header="Skills">
                <Border Classes="section" Margin="8" VerticalAlignment="Top">
                  <StackPanel Spacing="16">
                    <TextBlock Text="Historical Skill Ranks" FontSize="14" FontWeight="SemiBold" />
                    <UniformGrid Name="SkillRows" Columns="2" />
                  </StackPanel>
                </Border>
              </TabItem>
              <TabItem Header="Class Mastery">
                <Border Classes="section" Margin="8">
                  <Grid RowDefinitions="Auto,*" RowSpacing="12">
                    <TextBox Classes="Small" Name="ClassSearch" PlaceholderText="Search classes..."
                             TextChanged="ClassSearch_TextChanged" />
                    <ScrollViewer Grid.Row="1">
                      <UniformGrid Name="ClassRows" Columns="2" />
                    </ScrollViewer>
                  </Grid>
                </Border>
              </TabItem>
            </TabControl>
          </Grid>
        </Grid>
      </TabItem>

      <TabItem Name="InheritanceSupportTab" Header="NG+ Support Talks">
        <Grid Margin="8" ColumnDefinitions="312,*" ColumnSpacing="8">
          <Border Classes="section" Grid.Column="0">
            <Grid RowDefinitions="Auto,*" RowSpacing="12">
              <TextBlock Text="Talk List" FontWeight="SemiBold" />
              <Grid Grid.Row="1" RowDefinitions="Auto,*" RowSpacing="5">
                <TextBox Classes="Small" Name="SupportSearch" PlaceholderText="Search character pairs..."
                         TextChanged="SupportSearch_TextChanged" />
                <ListBox Classes="Small" Name="SupportList" Grid.Row="1"
                         SelectionChanged="SupportList_SelectionChanged" />
              </Grid>
            </Grid>
          </Border>
          <Grid Grid.Column="1" RowDefinitions="Auto,*" RowSpacing="8">
            <Border Classes="section">
              <StackPanel Spacing="12">
                <TextBlock Text="Talk Editor" FontWeight="SemiBold" />
                <Grid RowDefinitions="Auto,Auto,Auto" ColumnDefinitions="100,*" RowSpacing="7" ColumnSpacing="8">
                  <TextBlock Name="SelectedSupport" Grid.ColumnSpan="2" Text="Select a support pair"
                             TextWrapping="Wrap" />
                  <TextBlock Grid.Row="1" Text="Support:" VerticalAlignment="Center" />
                  <ComboBox Classes="Small" Name="SupportRankPreset" Grid.Row="1" Grid.Column="1" />
                  <Button Classes="Small" Grid.Row="2" Grid.Column="1"
                          Content="Set" Click="ApplySupport_Click" />
                </Grid>
                <TextBlock Name="SupportRawPoints" />
              </StackPanel>
            </Border>
            <TextBlock Grid.Row="1" Margin="8,0" TextWrapping="Wrap"
                       Text="These are point presets, not guaranteed dialogue ranks. Some pairs have extra conversations or cannot reach S." />
          </Grid>
        </Grid>
      </TabItem>
    </TabControl>
  </DockPanel>
  <Border Name="StatusNotice" Classes="section" IsVisible="False"
          HorizontalAlignment="Right" VerticalAlignment="Bottom"
          Margin="16" Padding="12,8" MaxWidth="500">
    <TextBlock Name="Status" TextWrapping="Wrap" />
  </Border>
  </Grid>
</Window>
