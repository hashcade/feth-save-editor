<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="using:FethEditor.Gui"
        x:Class="FethEditor.Gui.SystemWindow"
        Title="System Save Editor" Width="820" Height="600" MinWidth="600" MinHeight="400"
        FontSize="12" DragDrop.AllowDrop="True">
  <Window.Styles>
    <Style Selector="Border.section">
      <Setter Property="Padding" Value="16" />
    </Style>
  </Window.Styles>
  <DockPanel>
    <Menu DockPanel.Dock="Top" Height="24">
      <MenuItem Header="_File">
        <MenuItem Header="_Load System Save..." Click="OpenSystem_Click" />
        <MenuItem Name="WriteSystemMenu" Header="_Write Save..."
                  IsEnabled="False" Click="WriteSystem_Click" />
        <Separator />
        <MenuItem Header="E_xit" Click="Exit_Click" />
      </MenuItem>
    </Menu>
    <Border DockPanel.Dock="Bottom" Padding="6,3">
      <TextBlock Name="SystemStatus" Text="Load a system save to begin." />
    </Border>
    <Grid Margin="8" ColumnDefinitions="245,*" ColumnSpacing="8">
      <Border Classes="section">
        <Grid RowDefinitions="Auto,*" RowSpacing="12">
          <TextBlock Text="Save Slots" FontWeight="SemiBold" />
          <ListBox Classes="Small" Name="SystemSlots" Grid.Row="1" />
        </Grid>
      </Border>
      <Border Classes="section" Grid.Column="1">
        <Grid RowDefinitions="Auto,*" RowSpacing="12">
          <TextBlock Text="System Flags" FontWeight="SemiBold" />
          <ListBox Classes="Small" Name="SystemFlags" Grid.Row="1">
            <ListBox.ItemTemplate>
              <DataTemplate x:DataType="local:SystemFlagRow">
                <CheckBox Content="{Binding Label}" IsChecked="{Binding Enabled, Mode=TwoWay}" />
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </Grid>
      </Border>
    </Grid>
  </DockPanel>
</Window>
